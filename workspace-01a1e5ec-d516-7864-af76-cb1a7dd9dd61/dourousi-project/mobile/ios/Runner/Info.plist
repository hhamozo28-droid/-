<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>دروسي</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>dz.dourousi.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>dourousi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>fr</string>
		<string>en</string>
	</array>
	<!-- Biometric Face ID Permission -->
	<key>NSFaceIDUsageDescription</key>
	<string>يستخدم تطبيق دروسي بصمة الوجه لحماية ملفاتك التدريبية المشفرة عند فتح التطبيق.</string>
	<!-- Disable iTunes/Finder file sharing for strict DRM protection -->
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Custom URL Scheme for Deep Links (Universal Links configured via Associated Domains: applinks:dourousi.app) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>dz.dourousi.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dourousi</string>
			</array>
		</dict>
	</array>
	<!-- Enforce HTTPS / TLS 1.3 via App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
